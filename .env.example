# ==============================================================================
# NAMMUDE NAADU ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Public Keys (Safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO FRONTEND)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Google Gemini API Key for Naadu AI (SERVER-SIDE ONLY - NEVER EXPOSE TO FRONTEND)
# Obtain from https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# Google Maps Platform API Key (Public Client Key for Digital Tanur GIS Map)
# Enable: Maps JavaScript API, Places API
# Set HTTP referrer restriction: https://yourdomain.com/* or http://localhost:3000/*
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
